<Project Sdk="Microsoft.NET.Sdk">

  <!-- Plain console test runner. See README.md for how to run it. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <SimHubPath Condition="'$(SIMHUB_INSTALL_PATH)' != ''">$([MSBuild]::EnsureTrailingSlash('$(SIMHUB_INSTALL_PATH)'))</SimHubPath>
    <SimHubPath Condition="'$(SimHubPath)' == ''">C:\Program Files (x86)\SimHub\</SimHubPath>
  </PropertyGroup>

  <ItemGroup>
    <!-- Frames and a recording from a real capture; see ScreenTests.cs. -->
    <Content Include="data\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Reference Include="System.Drawing" />
    <!-- The capture box window can be shown by hand; see the box option in Program.cs. -->
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
    <Reference Include="WindowsBase" />
    <Reference Include="System.Xaml" />
    <ProjectReference Include="..\LovelyCarDataCapture.csproj" />
    <!-- Lifecycle tests run the plugin and its worker outside SimHub. -->
    <Reference Include="SimHub.Plugins">
      <HintPath>$(SimHubPath)SimHub.Plugins.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="GameReaderCommon">
      <HintPath>$(SimHubPath)GameReaderCommon.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="iRacingSDK">
      <HintPath>$(SimHubPath)iRacingSDK.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="SimHub.Logging">
      <HintPath>$(SimHubPath)SimHub.Logging.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <!-- Copied here so the tests can run outside SimHub. -->
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(SimHubPath)Newtonsoft.Json.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

</Project>
