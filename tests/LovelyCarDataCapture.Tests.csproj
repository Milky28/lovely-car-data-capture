<Project Sdk="Microsoft.NET.Sdk">

  <!-- Plain console test runner. See README.md for how to run it. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <SimHubPath Condition="'$(SIMHUB_INSTALL_PATH)' != ''">$([MSBuild]::EnsureTrailingSlash('$(SIMHUB_INSTALL_PATH)'))</SimHubPath>
    <SimHubPath Condition="'$(SimHubPath)' == ''">C:\Program Files (x86)\SimHub\</SimHubPath>
  </PropertyGroup>

  <ItemGroup>
    <!-- Frames and a recording from a real capture; see ScreenTests.cs. -->
    <Content Include="data\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Reference Include="System.Drawing" />
    <ProjectReference Include="..\LovelyCarDataCapture.csproj" />
    <!-- Copied here so the tests can run outside SimHub. -->
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(SimHubPath)Newtonsoft.Json.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

</Project>
